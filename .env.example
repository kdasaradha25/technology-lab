# Deployment settings for the `main` branch (copied to .env by deploy/init-env.sh).

# Base domain. Every app gets a subdomain: react.<DOMAIN>, django.<DOMAIN>, ...
# DNS for <DOMAIN> and *.<DOMAIN> must point at the server.
#   Own domain:   lab.example.com  (A records for lab and *.lab)
#   DuckDNS:      myname.duckdns.org  (covers subdomains automatically)
#   No domain:    203-0-113-10.sslip.io  (your server IP with dashes)
# Left empty on purpose: `docker compose up` refuses to start until it is set.
DOMAIN=
