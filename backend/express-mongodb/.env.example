# API
PORT=8003

# Frontend origins allowed by CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200

# MongoDB
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=technology_lab
MONGO_USER=lab_user
MONGO_PASSWORD=change-me
# Database the user is defined in (the Docker root user lives in "admin")
MONGO_AUTH_SOURCE=admin
# Milliseconds to wait for MongoDB before reporting unhealthy
MONGO_TIMEOUT_MS=3000
