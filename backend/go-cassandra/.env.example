# API
PORT=8004

# Frontend origins allowed by CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200

# Cassandra
# Contact points (comma separated)
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=technology_lab
CASSANDRA_CONSISTENCY=LOCAL_ONE
CASSANDRA_REPLICATION_FACTOR=1
# Per-query timeout and connection timeout (Go durations or seconds)
CASSANDRA_TIMEOUT=3s
CASSANDRA_CONNECT_TIMEOUT=5s
# Leave empty: the Docker image runs without authentication.
# Set both if your Cassandra uses PasswordAuthenticator.
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
