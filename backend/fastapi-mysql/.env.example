# API
API_PORT=8002
LOG_LEVEL=INFO

# Frontend origins allowed by CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200

# MySQL
MYSQL_DATABASE=technology_lab
MYSQL_USER=lab_user
MYSQL_PASSWORD=change-me
# Used only by the MySQL container
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Seconds to wait for a database connection before reporting unhealthy
MYSQL_CONNECT_TIMEOUT=3

# Startup: how often to retry creating tables while MySQL is still starting
DB_STARTUP_RETRIES=5
DB_STARTUP_RETRY_DELAY=2
