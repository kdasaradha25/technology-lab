# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_PORT=8001
LOG_LEVEL=INFO

# Frontend origins allowed by CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200

# PostgreSQL
POSTGRES_DB=technology_lab
POSTGRES_USER=lab_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Seconds to wait for a database connection before reporting unhealthy
POSTGRES_CONNECT_TIMEOUT=3
