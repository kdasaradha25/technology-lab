# API
API_PORT=8006
LOG_LEVEL=INFO

# Frontend origins allowed by CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me
# Seconds for connect and socket operations
REDIS_TIMEOUT=2

# InfluxDB 2.x
# Secrets must NOT start with "-" (InfluxDB's setup reads them as CLI flags).
# Generate safe ones with: python -c "import secrets; print(secrets.token_hex(32))"
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_ORG=technology-lab
INFLUXDB_BUCKET=health
INFLUXDB_TOKEN=change-me-to-a-long-random-token
# Milliseconds per HTTP request to InfluxDB
INFLUXDB_TIMEOUT_MS=3000

# Used only by the InfluxDB container's first-time setup
INFLUXDB_ADMIN_USER=lab_admin
INFLUXDB_ADMIN_PASSWORD=change-me-too
