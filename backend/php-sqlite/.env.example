# API port (used by docker-compose and the README commands)
PORT=8005

# Frontend origins allowed by CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200

# SQLite database file. Relative paths are resolved from the project root.
DB_PATH=database/app.sqlite
# Seconds to wait when the database file is locked by another writer
DB_TIMEOUT=3
